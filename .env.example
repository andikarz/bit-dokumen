# bit-dokumen environment
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://document_user:document_secret@postgres-document:5432/document_db

# JWT verification (public key only)
JWT_ISSUER=beasiswa-rbac
JWT_AUDIENCE=beasiswa-api
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem

# Internal service identity
INTERNAL_SIGNING_KEY_FILE=./secrets/service-key.pem
INTERNAL_GATEWAY_URL=http://api-gateway:9080

# Gateway assertion verification
GATEWAY_ASSERTION_PUBLIC_KEY_FILE=./secrets/gateway-assertion-public.pem

# File storage
STORAGE_ROOT=/storage/permohonan
MAX_FILE_BYTES=2097152

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
SCAN_TIMEOUT_MS=30000
