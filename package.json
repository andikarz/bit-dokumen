{
  "name": "bit-dokumen",
  "version": "0.1.0",
  "private": true,
  "description": "Dokumen service — file upload, scan, storage (PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:status": "tsx scripts/migrate.ts --status",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.16.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.4",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "multer": "^1.4.5-lts.2",
    "file-type": "^20.5.0",
    "clamdjs": "^1.0.2",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/pg": "^8.11.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/uuid": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "eslint": "^9.26.0",
    "@eslint/js": "^9.26.0",
    "typescript-eslint": "^8.32.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
